{
  // Type-checking only: Vite compiles www/main (vite.config.mts for the
  // windows, vite.main.config.mts for the main process), so tsc never emits.
  // The renderer is TypeScript; the one vendored JS library (common/vendor/
  // tingle.js) is typed by the declaration next to it.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["www/main/**/*", "types/**/*.d.ts", "vite.config.mts", "vite.main.config.mts"]
}
