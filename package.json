{
  "productName": "SikhiToTheMax",
  "name": "sttm-desktop",
  "version": "9.3.2",
  "description": "The SikhiToTheMax desktop app",
  "main": "app.js",
  "scripts": {
    "prebuild": "cross-env node packaging/update-packagejson.js",
    "precommit": "npm test",
    "test": "run-p test:*",
    "test:lint": "run-p test:lint:*",
    "test:lint:html": "htmlhint --config .htmlhintrc www",
    "test:lint:js": "eslint app.js packaging www/main types",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:local && concurrently --kill-others \"npm run watch-css\" \"npm run watch-renderer\" \"cross-env NODE_ENV=development electron .\"",
    "dev": "npm run build:local && concurrently --kill-others \"npm run watch-css\" \"npm run dev:renderer\" \"wait-on tcp:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "run-p build-css build-main && npm run build-renderer",
    "build:local": "run-p build-css build-main && npm run build-renderer",
    "pack:mac": "npm run build && electron-builder --mac --x64 --publish never",
    "pack:macArm": "npm run build && electron-builder -c packaging/electron-builder.macArm.yml --mac --arm64 --publish never",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:win32": "npm run build && electron-builder --win --ia32",
    "pack:linux": "npm run build && electron-builder --linux --x64",
    "pack:berry": "export USE_SYSTEM_FPM=true && npm run build && electron-builder --linux --arm64",
    "dist:mac": "npm run build && electron-builder --mac --x64 --publish always",
    "dist:macArm": "npm run build && electron-builder -c packaging/electron-builder.macArm.yml --mac --arm64 --publish always",
    "dist:win": "npm run pack:win && electron-builder --win --x64 --publish always",
    "dist:win32": "npm run pack:win32 && electron-builder --win --ia32 --publish always",
    "build-css": "run-p build-css:*",
    "build-css:main": "sass --style=compressed --no-source-map --load-path=www/src/scss --load-path=node_modules www/src/scss/styles.scss www/assets/css/bundle.css",
    "build-css:obs": "sass --style=compressed --no-source-map --load-path=www/src/scss/obs www/src/scss/obs/styles.scss www/obs/bundle.css",
    "build-main": "vite build -c vite.main.config.mts",
    "build-renderer": "vite build",
    "watch-renderer": "vite build --watch",
    "dev:renderer": "vite",
    "watch-css": "nodemon --watch www -e scss -x \"npm run build-css\"",
    "postinstall": "patch-package && electron-builder install-app-deps"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:khalisfoundation/sttm-desktop.git"
  },
  "author": "Khalis, Inc. <techsupport@khalisfoundation.org>",
  "license": "OSL-3.0",
  "devDependencies": {
    "@electron/notarize": "^2.3.0",
    "@khalisfoundation/banidb": "0.2.0",
    "@khalisfoundation/sikhi-ui": "1.36.1",
    "@mynaui/icons-react": "^0.4.11",
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^24.13.3",
    "electron-react-devtools": "^0.5.3",
    "eslint": "^8.50.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.33.2",
    "htmlhint": "^1.9.2",
    "husky": "^8.0.3",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.9",
    "pretty-quick": "^4.2.2",
    "sass": "^1.105.0",
    "semver": "^7.5.4",
    "simple-git": "^3.36.0",
    "ssh2": "^1.17.0",
    "stylelint": "^14.9.1",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^26.0.0",
    "stylelint-order": "^5.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "@electron/remote": "^2.0.11",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/electron": "^6.11.0",
    "anvaad-js": "^1.5.1",
    "axios": "^1.5.1",
    "copy-to-clipboard": "^3.3.3",
    "dotenv": "^16.3.1",
    "electron-chromecast": "^1.1.0",
    "electron-log": "^4.4.8",
    "electron-updater": "^6.8.9",
    "express": "^4.22.3",
    "extract-zip": "^2.0.1",
    "get-json": "^1.0.1",
    "html-react-parser": "^4.2.2",
    "http-shutdown": "^1.2.2",
    "i18next": "^23.5.1",
    "i18next-fs-backend": "^2.6.8",
    "image-type": "^4.1.0",
    "is-online": "^9.0.1",
    "lodash.camelcase": "^4.3.0",
    "lodash.defaultsdeep": "^4.6.1",
    "lodash.get": "^4.4.2",
    "marked": "^9.0.3",
    "moment": "^2.31.0",
    "node-fetch": "^2.7.0",
    "node-gyp": "^9.4.0",
    "noty": "^3.2.0-beta",
    "portfinder": "1.0.32",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.3.0",
    "react-transition-group": "^4.4.5",
    "react-virtuoso": "^4.18.15",
    "read-chunk": "^3.2.0",
    "sharp": "^0.32.6",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "org.khalisfoundation.sttm",
    "protocols": {
      "name": "SikhiToTheMax",
      "schemes": [
        "sttm-desktop"
      ]
    },
    "copyright": "Copyright © 2022 Khalis Foundation , SikhiToTheMax Trademark SHARE Charity, UK\n",
    "files": [
      "**/*",
      "!assets${/*}",
      "!builds${/*}",
      "!**/scss${/*}",
      "!packaging${/*}",
      "!test${/*}",
      "!www/node_modules${/*}",
      "!www/package.json",
      "!**/{.eslintignore,.eslintrc,.gitmodules,.htmlhintrc,.stylelintrc,.travis.yml,appveyor.yml,data.db,id_rsa.enc,README,STTM.provisionprofile}",
      "!**/*.map",
      "!www/main/**/*.{js,jsx,ts,tsx}",
      "!types${/*}",
      "!tsconfig.json",
      "!vite.config.mts",
      "!vite.main.config.mts",
      "!www/js${/*}"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**/*"
    ],
    "extraResources": [
      "data.db"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "builds"
    },
    "publish": {
      "provider": "s3",
      "bucket": "sttm-releases",
      "path": "${os}-${arch}",
      "region": "us-west-2"
    },
    "dmg": {
      "icon": "assets/STTM-DMG.icns",
      "artifactName": "SikhiToTheMax-${version}-${os}-${arch}.dmg"
    },
    "mac": {
      "category": "public.app-category.reference",
      "icon": "assets/STTM.icns",
      "hardenedRuntime": true,
      "artifactName": "SikhiToTheMax-${version}-${os}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Please give us access to your microphone for voice search",
        "NSCameraUsageDescription": "Please give us access to your camera",
        "com.apple.security.device.audio-input": true,
        "com.apple.security.device.camera": true
      },
      "entitlements": "./entitlements.mac.inherit.plist",
      "entitlementsInherit": "./entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "notarize": {
        "teamId": ""
      }
    },
    "afterSign": "./notarize.js",
    "nsis": {
      "artifactName": "SikhiToTheMaxSetup-${version}.${ext}",
      "deleteAppDataOnUninstall": true,
      "perMachine": true
    },
    "win": {
      "icon": "assets/STTM.ico",
      "publisherName": [
        "KHALIS FOUNDATION (KHALIS, INC.)",
        "KHALIS INC"
      ],
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "artifactName": "SikhiToTheMax-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "category": "Network",
      "target": "deb",
      "icon": "assets"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged",
      "pre-push": "npm test"
    }
  },
  "extendInfo": {
    "NSAppTransportSecurity": {
      "NSAllowsArbitraryLoads": true
    }
  },
  "overrides": {
    "nan": "^2.29.0"
  }
}
